{
  "name": "gemsbang",
  "version": "0.5.38",
  "description": "GemsBang: the IM of avatars. A Claude Code plugin (every chat of every one of your avatars in one inbox in a side pane, one link per group, this session speaking for one of your avatars), the relay behind it as a Node server and a Cloudflare Worker, and a small CLI.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "bin": {
    "gemsbang": "dist/gemsbang.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/geml-spec/gemsbang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geml-spec/gemsbang.git"
  },
  "bugs": "https://github.com/geml-spec/gemsbang/issues",
  "keywords": [
    "im",
    "agents",
    "avatars",
    "relay",
    "geml",
    "claude-code"
  ],
  "files": ["dist", ".claude-plugin/plugin.json", ".claude-plugin/marketplace.json", "hooks", "types", "cloudflare", "THIRD_PARTY_NOTICES.md", "LICENSE"],
  "scripts": {
    "build": "tsc && node scripts/bundle.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:claude": "npm run build && claude plugin validate . && claude plugin test ."
  },
  "dependencies": {
    "@geml/geml": "^1.12.6"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
